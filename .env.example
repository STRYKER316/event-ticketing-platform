# Copy to .env and fill in for local development. No real secrets belong in this file.

# --- Postgres (per-service databases, §12) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme

EVENT_DB_NAME=event_db
EVENT_DB_USER=event_service
EVENT_DB_PASSWORD=changeme

BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_service
BOOKING_DB_PASSWORD=changeme

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=changeme

# --- MongoDB (event-service seat maps) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# --- Kafka (KRaft mode, §7) ---
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Public origin (P10, EB deployment) ---
# Scheme + host the app is actually reached at, no trailing slash and no
# port (Traefik's port 80 is implicit). Drives Keycloak's realm redirectUris/
# webOrigins (infra/keycloak/entrypoint.sh) and AUTH_KEYCLOAK_ISSUER below --
# both must match whatever host issued the browser's token. Set to the EB
# environment's CNAME (http://<cname>) as an EB environment property; the
# local default below needs no change.
APP_ORIGIN=http://localhost

# --- Keycloak (§5, §15) ---
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=ticketing
KEYCLOAK_CLIENT_ID=ticketing-frontend
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Stripe (test mode, P4) ---
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# --- Service ports ---
# event-service (8001) and search-service (8002) are container-internal only
# (Dockerfile CMD + Traefik label, not env-configurable) -- no entry needed here.
BOOKING_SERVICE_PORT=8003
PAYMENT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005

# --- Traefik ---
TRAEFIK_DASHBOARD_PORT=8080

# --- Prometheus + Grafana (benchmark profile only, `make bench-up`, P8) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
