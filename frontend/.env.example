# Standalone dev (`npm run dev`, served on :5173) values. None of the
# backend services publish a host port of their own — only Traefik does
# (infra/docker-compose.yml, "80:80") — so every service URL below always
# routes through it, path-prefixed. Run the backend stack first
# (`docker compose up`, frontend container excluded) before `npm run dev`.
VITE_EVENT_SERVICE_URL=http://localhost
VITE_SEARCH_SERVICE_URL=http://localhost
VITE_BOOKING_SERVICE_URL=http://localhost
# Port + realm only, not a full issuer URL -- the host is resolved at
# runtime from window.location (see src/auth/oidcConfig.ts), which for this
# standalone dev-server workflow is localhost:5173, giving the same
# http://localhost:8081/realms/ticketing issuer as before.
VITE_KEYCLOAK_PORT=8081
VITE_KEYCLOAK_REALM=ticketing
