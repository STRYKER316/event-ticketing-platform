# Standalone dev (`npm run dev`, served on :5173) values. Empty/relative,
# matching the Docker-served build (infra/docker-compose.yml's frontend
# build args) — an absolute http://localhost value here would make every
# fetch cross-origin from :5173 and get blocked by CORS, since no backend
# service sends Access-Control-Allow-Origin. vite.config.ts's dev-server
# proxy forwards these relative paths to Traefik (:80) instead. Run the
# backend stack first (`docker compose up`, frontend container excluded)
# before `npm run dev`.
VITE_EVENT_SERVICE_URL=
VITE_SEARCH_SERVICE_URL=
VITE_BOOKING_SERVICE_URL=
# Port + realm only, not a full issuer URL -- the host is resolved at
# runtime from window.location (see src/auth/oidcConfig.ts), which for this
# standalone dev-server workflow is localhost:5173, giving the same
# http://localhost:8081/realms/ticketing issuer as before.
VITE_KEYCLOAK_PORT=8081
VITE_KEYCLOAK_REALM=ticketing
