{
  "realm": "ticketing",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "user", "description": "Can browse events and book tickets" },
      { "name": "organizer", "description": "Can create and manage events" }
    ]
  },
  "clients": [
    {
      "clientId": "ticketing-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "ticketing-service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "changeme",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "ticketing-services-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ticketing-services",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Anderson",
      "email": "alice@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "changeme", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Baker",
      "email": "bob@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "changeme", "temporary": false }
      ],
      "realmRoles": ["user", "organizer"]
    },
    {
      "username": "carol",
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Clarke",
      "email": "carol@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "changeme", "temporary": false }
      ],
      "realmRoles": ["organizer"]
    }
  ]
}
